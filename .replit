[env]
PYTHONUNBUFFERED = "1"

[packageManager]
type = "pip"
packages = ["streamlit==1.28.1", "pandas==2.1.3", "requests==2.31.0", "cachetools==5.3.2"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
author = "user"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install -r requirements.txt && streamlit run sportsbook_dashboard.py"

[workflows.workflow.metadata]
outputType = "webview"
